# ==========================================
# TASKFLOW - .gitignore
# ==========================================

# Dependencias
node_modules/
*/node_modules/
jspm_packages/
.pnp/
.pnp.js

# Variables de entorno y credenciales
.env
.env.local
.env.*.local
*.env
!.env.example
!*/.env.example

# Logs y depuración
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Compilación y artefactos de distribución (Frontend / Vite)
dist/
dist-ssr/
build/
*/dist/
out/
.output/

# Caché y herramientas de desarrollo local
.cache/
.vite/
.eslintcache
.stylelintcache
.freebuff/

# Bases de datos y almacenamiento local
mongo-data/
data/
*.rdb

# Archivos temporales de Office (evita subir bloqueos de Word/Excel: ~$*.docx)
~$*
~$*.docx

# Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editores y entornos de desarrollo (IDEs)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
