# Servicios
PORT=3000
HOST=0.0.0.0
# Varios orígenes separados por coma (frontend local y otros entornos)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB Atlas
# Crea tu cluster en https://cloud.mongodb.com → obtén el connection string
# Reemplaza USER, PASSWORD y CLUSTER con tus datos reales
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/taskflow?retryWrites=true&w=majority

# Redis (en Docker Compose será: redis://redisserver:6379)
REDIS_URL=redis://localhost:6379

# Caché (TTL en segundos)
CACHE_TTL_SEGUNDOS=30

# Worker
WORKER_INTERVALO_MS=500
BACKEND_URL_PARA_WORKER=http://localhost:3000
