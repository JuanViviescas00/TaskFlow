# Servicios
PORT=3000
HOST=0.0.0.0
# Varios orígenes separados por coma (frontend local y otros entornos)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB (en Docker Compose será: mongodb://mongoserver:27017/taskflow)
MONGODB_URI=mongodb://localhost:27017/taskflow

# Redis (en Docker Compose será: redis://redisserver:6379)
REDIS_URL=redis://localhost:6379

# Caché (TTL en segundos)
CACHE_TTL_SEGUNDOS=30

# Worker
WORKER_INTERVALO_MS=500
BACKEND_URL_PARA_WORKER=http://localhost:3000
