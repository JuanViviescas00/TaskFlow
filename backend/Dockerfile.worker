# TASKFLOW Worker — proceso independiente (doc §8, regla 6)
# Imagen separada del backend: mismo código fuente, punto de entrada distinto.
# No publica puertos ni healthcheck HTTP: no sirve tráfico de red.

# ---- Etapa 1: dependencias de producción ----
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ---- Etapa 2: imagen final ----
FROM node:20-alpine
ENV NODE_ENV=production
WORKDIR /app

# Usuario sin privilegios (buena práctica)
RUN addgroup -S taskflow && adduser -S taskflow -G taskflow

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src

USER taskflow

# Proceso exclusivo del worker (doc regla 6)
CMD ["node", "src/worker/index.js"]
